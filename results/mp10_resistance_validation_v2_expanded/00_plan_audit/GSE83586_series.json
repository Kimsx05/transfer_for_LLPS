{
  "title": [
    "Molecular classification of bladder cancer: global mRNA classification versus tumor cell phenotype classification."
  ],
  "geo_accession": [
    "GSE83586"
  ],
  "status": [
    "Public on Mar 13 2017"
  ],
  "submission_date": [
